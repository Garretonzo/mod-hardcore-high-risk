[worldserver]

########################################
# mod-hardcore-high-risk
########################################
#
# Turns the realm into a hardcore realm: when the module is enabled, every character in the populations
# enabled below is hardcore. There is nothing to opt into. Hardcore deaths are kept in
# acore_characters.mod_hardcore_high_risk_character.
#
# When a hardcore character dies, everything it carried drops into chests next to its body (see LootDrop).
# Real players and altbots then stay on as permanent ghosts: they can still log in, move around and talk
# (say goodbye), but nothing can resurrect them; resurrection spells and soulstones are refused. Fallen altbots
# release at once into a ghost at their body and keep following their master. With mod-pbc installed, the
# fallen companion and its group's companions get a permanent memory of how it died. Random bots are reset or
# retired instead (see RandomBotDeathAction).
#
# To bring a fallen character back, delete its row and restart the worldserver:
#     DELETE FROM mod_hardcore_high_risk_character WHERE guid = <character guid>;
#
#    HardcoreHighRisk.Enable
#        Description: Master switch for the whole module.
#        Default:     1 - Enabled
#                     0 - Disabled
#

HardcoreHighRisk.Enable = 1

#
#    HardcoreHighRisk.Players
#        Description: Real players (anyone playing with a game client) are hardcore. Includes game masters.
#        Default:     1 - Enabled
#                     0 - Disabled
#

HardcoreHighRisk.Players = 1

#
#    HardcoreHighRisk.AltBots
#        Description: Altbots are hardcore: characters on real accounts controlled by mod-playerbots, mod-pbc
#                     companions included. A fallen altbot becomes a ghost that keeps following its master.
#        Default:     1 - Enabled
#                     0 - Disabled
#

HardcoreHighRisk.AltBots = 1

#
#    HardcoreHighRisk.RandomBots
#        Description: Random bots are hardcore: characters on the playerbots random-bot accounts, addclass bots
#                     included. On death their belongings drop and RandomBotDeathAction is applied.
#        Default:     1 - Enabled
#                     0 - Disabled
#

HardcoreHighRisk.RandomBots = 1

#
#    HardcoreHighRisk.LootDrop.Enable
#        Description: When a hardcore character dies, everything it carried drops into chests next to the body.
#                     Equipped gear (and gold) goes into "Gear of the Fallen" chests, bags and their contents into
#                     "Pack of the Fallen" chests. A loot window holds at most 18 items, so extra chests are spawned
#                     in a ring around the body when needed. Enchants, gems, durability and the crafter are kept.
#        Default:     1 - Enabled
#                     0 - Disabled
#

HardcoreHighRisk.LootDrop.Enable = 1

#
#    HardcoreHighRisk.LootDrop.ChestDuration
#        Description: Seconds before an unlooted chest despawns. A chest despawns at once when emptied.
#        Default:     60
#

HardcoreHighRisk.LootDrop.ChestDuration = 60

#
#    HardcoreHighRisk.LootDrop.DropGold
#        Description: Put the character's money into the first gear chest.
#        Default:     1 - Enabled
#                     0 - Disabled (money stays on the character)
#

HardcoreHighRisk.LootDrop.DropGold = 1

#
#    HardcoreHighRisk.LootDrop.GearChestEntry
#    HardcoreHighRisk.LootDrop.InventoryChestEntry
#        Description: gameobject_template entries for the two chest kinds (created by this module's SQL).
#        Default:     601000, 601001
#

HardcoreHighRisk.LootDrop.GearChestEntry = 601000
HardcoreHighRisk.LootDrop.InventoryChestEntry = 601001

#
#    HardcoreHighRisk.RandomBotDeathAction
#        Description: What happens to a hardcore random bot after it dies.
#        Default:     0 - Reset: resurrect at the starting level, re-gear, send to its race's starting zone
#                     1 - Retire: log out and delete the character (playerbots creates new bots on a later startup)
#

HardcoreHighRisk.RandomBotDeathAction = 0

#
#    HardcoreHighRisk.BotDeathActionDelay
#        Description: Seconds after a random bot's death before its reset or retire runs.
#        Default:     5
#

HardcoreHighRisk.BotDeathActionDelay = 5
